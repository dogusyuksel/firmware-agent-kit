# firmware-agent-kit Renode machine template. Pick a platform that exists in your Renode version:
#   ls <renode>/platforms/boards  /  <renode>/platforms/cpus
:name: firmware
:description: Runs build/app.elf on a simulated MCU

$name?="fw"
$platform?=@platforms/boards/stm32f4_discovery-kit.repl
$elf?=@build/app.elf

using sysbus
mach create $name
machine LoadPlatformDescription $platform

# Show the console UART in a window (interactive runs) and log unimplemented peripheral accesses
showAnalyzer sysbus.usart2
logLevel 2

macro reset
"""
    sysbus LoadELF $elf
"""
runMacro $reset
